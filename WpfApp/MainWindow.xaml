<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d" FontSize="20"
        Title="WPF Demo" Height="450" Width="900">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="20"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="20"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="20"/>
        </Grid.RowDefinitions>
        
        <TextBlock Grid.Column="1" Grid.Row="1" FontSize="28" 
                   Grid.ColumnSpan="2" Text="Hi hello in Movie Theater app"
                   Margin="20,0"/>

        <TextBlock Grid.Column="1" Grid.Row="2" FontWeight="Bold" 
                   Text="First Name" Margin="20,0,20,0"/>

        <TextBox x:Name="firstNameText" Grid.Column="2" 
                   Grid.Row="2" Width="200"/>

        <Button x:Name="submitButton" Content="Submit" 
                Grid.Column="1" Grid.Row="3"
                Grid.ColumnSpan="2" Margin="20"
                Click="submitButton_Click"/>
        <ComboBox x:Name="myComboBox" Grid.Column="1" Grid.Row="4" 
                  Grid.ColumnSpan="2" Margin="10">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding FullName}"></TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <!--<Image Grid.Column="4" Grid.Row="1" Grid.RowSpan="6"
               Source="C:\Users\cezar\OneDrive\Pictures\sznuk.jpg"></Image>-->
        
        <!--<MediaElement Grid.Column="4" Grid.Row="1" Grid.RowSpan="6"
               Source="C:\Users\cezar\OneDrive\Pictures\sznuk.jpg"
        -->
        <ScrollViewer Grid.Column="4" Grid.Row="1" 
                    Grid.RowSpan="6">
            <WrapPanel Orientation="Vertical">
                <Image MaxHeight="200" MaxWidth="200" Source="C:\Users\cezar\OneDrive\Pictures\sznuk.jpg"></Image>
                <Image MaxHeight="200" MaxWidth="200" Source="C:\Users\cezar\OneDrive\Pictures\sznuk.jpg"></Image>
                <Image MaxHeight="200" MaxWidth="200" Source="C:\Users\cezar\OneDrive\Pictures\sznuk.jpg"></Image>
                <Image MaxHeight="200" MaxWidth="200" Source="C:\Users\cezar\OneDrive\Pictures\sznuk.jpg"></Image>
            </WrapPanel>
        </ScrollViewer>
        
    </Grid>
</Window>
